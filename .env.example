# ───────────────────────────────────────────────────────────
# 비밀값 예시 — 실제 값은 .env 에 넣고(절대 커밋 금지), 환경변수로 주입합니다.
#   PowerShell:  $env:YOUTUBE_API_KEY="..."; $env:ANTHROPIC_API_KEY="..."; .\mvnw.cmd spring-boot:run
#   bash:        YOUTUBE_API_KEY=... ANTHROPIC_API_KEY=... ./mvnw spring-boot:run
# ───────────────────────────────────────────────────────────

# YouTube Data API v3 키 (Google Cloud Console에서 발급)
YOUTUBE_API_KEY=your_youtube_data_api_v3_key

# Anthropic Claude API 키 (https://console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key
