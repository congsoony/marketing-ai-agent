# ───────────────────────────────────────────────────────────
# 로컬 비밀값 파일 — 이 파일을 복사해 "secret.yml" 로 저장한 뒤 실제 키를 넣으세요.
#   secret.yml 은 .gitignore 로 제외되어 저장소에 올라가지 않습니다.
#   (src/main/resources 밖이라 빌드 산출물 jar 에도 포함되지 않습니다.)
#
# 복사:  PowerShell →  Copy-Item secret.yml.example secret.yml
#        bash       →  cp secret.yml.example secret.yml
#
# 환경변수(${YOUTUBE_API_KEY} 등)로 넣는 방식도 그대로 동작하며,
# 환경변수가 설정돼 있으면 그쪽이 우선합니다.
# ───────────────────────────────────────────────────────────
app:
  youtube:
    api-key: "여기에_AIza로_시작하는_YouTube_Data_API_v3_키"
  openai:
    api-key: "여기에_sk로_시작하는_OpenAI_키"
